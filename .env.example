# Получите ключ в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Основная модель.
GEMINI_MODEL=gemini-3.6-flash

# При ответе 429 приложение последовательно попробует эти модели.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Только для локальной проверки интерфейса без обращения к Gemini.
# GEMINI_MOCK=1

# Пароль для /admin. Используйте длинное уникальное значение.
ADMIN_PASSWORD=

# Отдельный случайный секрет для подписи HttpOnly-сессии.
# Например: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Vercel добавляет эту переменную автоматически после подключения private Blob.
BLOB_READ_WRITE_TOKEN=

# Только для локальной проверки админ-интерфейса без Vercel Blob.
# AUDIT_MOCK=1
